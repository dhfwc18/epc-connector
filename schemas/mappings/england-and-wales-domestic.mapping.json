{
  "$schema": "./mapping.schema.json",
  "source": "source/england-and-wales/domestic.schema.json",
  "target": "canonical/gb-domestic.schema.json",
  "description": "England and Wales domestic certificates (Get energy performance of buildings data) to the canonical GB domestic record.",
  "null_values": ["", "NO DATA!", "NODATA!", "INVALID!", "N/A"],
  "fields": {
    "source_dataset": {
      "const": "england-and-wales/domestic"
    },
    "country": {
      "from": "local_authority",
      "steps": [
        {
          "op": "regex_extract",
          "pattern": "^([EW])[0-9]",
          "group": 1
        },
        {
          "op": "map",
          "values": {
            "E": "england",
            "W": "wales"
          },
          "unmapped": "error"
        }
      ],
      "note": "ONS local authority codes start with E (England) or W (Wales)."
    },
    "certificate_id": {
      "from": "certificate_number"
    },
    "uprn": {
      "from": "uprn",
      "steps": [
        {
          "op": "cast",
          "to": "integer"
        }
      ]
    },
    "inspection_date": {
      "from": "inspection_date",
      "steps": [
        {
          "op": "cast",
          "to": "date",
          "format": "%Y-%m-%d"
        }
      ]
    },
    "lodgement_date": {
      "from": "lodgement_date",
      "steps": [
        {
          "op": "cast",
          "to": "date",
          "format": "%Y-%m-%d"
        }
      ]
    },
    "lodged_at": {
      "from": "lodgement_datetime",
      "steps": [
        {
          "op": "cast",
          "to": "datetime",
          "format": "%Y-%m-%d %H:%M:%S"
        }
      ]
    },
    "superseded": {
      "const": null,
      "note": "England and Wales do not flag superseded certificates."
    },
    "address_line_1": {
      "from": "address1"
    },
    "address_line_2": {
      "from": "address2"
    },
    "post_town": {
      "from": "posttown"
    },
    "postcode": {
      "from": "postcode"
    },
    "local_authority_name": {
      "from": "local_authority_label"
    },
    "current_energy_rating": {
      "from": "current_energy_rating"
    },
    "current_energy_efficiency": {
      "from": "current_energy_efficiency",
      "steps": [
        {
          "op": "cast",
          "to": "integer"
        }
      ]
    },
    "potential_energy_rating": {
      "from": "potential_energy_rating"
    },
    "potential_energy_efficiency": {
      "from": "potential_energy_efficiency",
      "steps": [
        {
          "op": "cast",
          "to": "integer"
        }
      ]
    },
    "property_type": {
      "from": "property_type",
      "steps": [
        {
          "op": "lower"
        }
      ]
    },
    "built_form": {
      "from": "built_form",
      "steps": [
        {
          "op": "lower"
        },
        {
          "op": "null_if",
          "values": ["not recorded"]
        }
      ]
    },
    "tenure": {
      "from": "tenure",
      "steps": [
        {
          "op": "lower"
        },
        {
          "op": "map",
          "values": {
            "rental (private)": "rented (private)",
            "rental (social)": "rented (social)",
            "not defined - use in the case of a new dwelling for which the intended tenure in not known. it is not to be used for an existing dwelling": "unknown"
          },
          "unmapped": "keep"
        }
      ]
    },
    "construction_age_band": {
      "from": "construction_age_band",
      "steps": [
        {
          "op": "strip_prefix",
          "prefix": "England and Wales: "
        },
        {
          "op": "null_if",
          "values": ["Not applicable", "Not recorded"]
        }
      ]
    },
    "construction_year_min": {
      "from": "construction_age_band",
      "steps": [
        {
          "op": "strip_prefix",
          "prefix": "England and Wales: "
        },
        {
          "op": "map",
          "values": {
            "before 1900": null,
            "Pre-1900": null,
            "1900-1929": 1900,
            "1930-1949": 1930,
            "1950-1966": 1950,
            "1967-1975": 1967,
            "1976-1982": 1976,
            "1983-1990": 1983,
            "1991-1995": 1991,
            "1996-2002": 1996,
            "2003-2006": 2003,
            "2007-2011": 2007,
            "2007 onwards": 2007,
            "Post-2006": 2007,
            "2012 onwards": 2012,
            "2012-2021": 2012,
            "2022 onwards": 2022,
            "Not applicable": null,
            "Not recorded": null
          },
          "unmapped": "keep"
        },
        {
          "op": "cast",
          "to": "integer"
        }
      ],
      "note": "Unmapped values must be a single year (new-build lodgements), otherwise the cast fails."
    },
    "construction_year_max": {
      "from": "construction_age_band",
      "steps": [
        {
          "op": "strip_prefix",
          "prefix": "England and Wales: "
        },
        {
          "op": "map",
          "values": {
            "before 1900": 1899,
            "Pre-1900": 1899,
            "1900-1929": 1929,
            "1930-1949": 1949,
            "1950-1966": 1966,
            "1967-1975": 1975,
            "1976-1982": 1982,
            "1983-1990": 1990,
            "1991-1995": 1995,
            "1996-2002": 2002,
            "2003-2006": 2006,
            "2007-2011": 2011,
            "2007 onwards": null,
            "Post-2006": null,
            "2012 onwards": null,
            "2012-2021": 2021,
            "2022 onwards": null,
            "Not applicable": null,
            "Not recorded": null
          },
          "unmapped": "keep"
        },
        {
          "op": "cast",
          "to": "integer"
        }
      ],
      "note": "Unmapped values must be a single year (new-build lodgements), otherwise the cast fails."
    },
    "total_floor_area": {
      "from": "total_floor_area",
      "steps": [
        {
          "op": "cast",
          "to": "number"
        },
        {
          "op": "null_if",
          "values": [0]
        }
      ],
      "note": "A floor area of 0 is not a real measurement."
    },
    "main_heating_energy_efficiency": {
      "from": "mainheat_energy_eff",
      "steps": [
        {
          "op": "first_part",
          "separator": "|",
          "skip": ["N/A"]
        },
        {
          "op": "lower"
        }
      ]
    },
    "main_heating_controls_energy_efficiency": {
      "from": "mainheatc_energy_eff",
      "steps": [
        {
          "op": "first_part",
          "separator": "|",
          "skip": ["N/A"]
        },
        {
          "op": "lower"
        }
      ]
    },
    "hot_water_energy_efficiency": {
      "from": "hot_water_energy_eff",
      "steps": [
        {
          "op": "first_part",
          "separator": "|",
          "skip": ["N/A"]
        },
        {
          "op": "lower"
        }
      ]
    },
    "walls_energy_efficiency": {
      "from": "walls_energy_eff",
      "steps": [
        {
          "op": "first_part",
          "separator": "|",
          "skip": ["N/A"]
        },
        {
          "op": "lower"
        }
      ]
    },
    "roof_energy_efficiency": {
      "from": "roof_energy_eff",
      "steps": [
        {
          "op": "first_part",
          "separator": "|",
          "skip": ["N/A"]
        },
        {
          "op": "lower"
        }
      ]
    },
    "floor_energy_efficiency": {
      "from": "floor_energy_eff",
      "steps": [
        {
          "op": "first_part",
          "separator": "|",
          "skip": ["N/A"]
        },
        {
          "op": "lower"
        }
      ]
    },
    "windows_energy_efficiency": {
      "from": "windows_energy_eff",
      "steps": [
        {
          "op": "first_part",
          "separator": "|",
          "skip": ["N/A"]
        },
        {
          "op": "lower"
        }
      ]
    },
    "lighting_energy_efficiency": {
      "from": "lighting_energy_eff",
      "steps": [
        {
          "op": "first_part",
          "separator": "|",
          "skip": ["N/A"]
        },
        {
          "op": "lower"
        }
      ]
    },
    "has_solar_pv": {
      "from": "photo_supply",
      "steps": [
        {
          "op": "cast",
          "to": "number"
        },
        {
          "op": "greater_than",
          "value": 0
        }
      ],
      "note": "photo_supply is the percentage of roof area covered by PV."
    },
    "has_solar_water_heating": {
      "from": "solar_water_heating_flag",
      "steps": [
        {
          "op": "boolean",
          "true": ["Y"],
          "false": ["N"]
        }
      ]
    },
    "co2_emissions_current": {
      "from": "co2_emissions_current",
      "steps": [
        {
          "op": "cast",
          "to": "number"
        }
      ]
    },
    "heating_cost_current": {
      "from": "heating_cost_current",
      "steps": [
        {
          "op": "cast",
          "to": "number"
        }
      ]
    },
    "hot_water_cost_current": {
      "from": "hot_water_cost_current",
      "steps": [
        {
          "op": "cast",
          "to": "number"
        }
      ]
    },
    "lighting_cost_current": {
      "from": "lighting_cost_current",
      "steps": [
        {
          "op": "cast",
          "to": "number"
        }
      ]
    }
  }
}
