    "glazing_discarded": {
      "description": "Glazing type: why the description was unusable, if it was.",
      "type": ["string", "null"],
      "enum": ["not defined", "not in vocabulary", null]
    },
    "main_heating_system": {
      "description": "Main heating: system.",
      "type": ["string", "null"],
      "enum": [
        "air source heat pump",
        "boiler",
        "community heat pump",
        "community scheme",
        "electric ceiling heating",
