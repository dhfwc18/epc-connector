{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epc-connector:schemas:canonical:gb-domestic",
  "title": "GB domestic EPC record (canonical)",
  "description": "One domestic Energy Performance Certificate for Great Britain, mapped from a source dataset (see schemas/mappings/). Values are typed; every field is present and is null when the source has no value.",
  "type": "object",
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "year": {
      "type": ["integer", "null"],
      "minimum": 1000,
      "maximum": 2100
    },
    "rating_band": {
      "type": ["string", "null"],
      "enum": ["A", "B", "C", "D", "E", "F", "G", null]
    },
    "sap_score": {
      "type": ["integer", "null"]
    },
    "efficiency": {
      "type": ["string", "null"],
      "enum": ["very good", "good", "average", "poor", "very poor", null]
    },
    "non_negative": {
      "type": ["number", "null"],
      "minimum": 0
    }
  },
  "properties": {
    "source_dataset": {
      "description": "Source dataset the record came from (path under schemas/source/).",
      "type": "string",
      "enum": ["england-and-wales/domestic", "scotland/domestic"]
    },
    "country": {
      "description": "Country of the property. England and Wales are told apart by the local authority code.",
      "type": ["string", "null"],
      "enum": ["england", "wales", "scotland", null]
    },
    "certificate_id": {
      "description": "Certificate identifier: CERTIFICATE_NUMBER (England and Wales) or REPORT_REFERENCE_NUMBER (Scotland).",
      "type": ["string", "null"],
      "minLength": 1
    },
    "uprn": {
      "description": "Unique Property Reference Number (Scotland: OSG reference number).",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "inspection_date": {
      "description": "Date the property was assessed.",
      "$ref": "#/$defs/date"
    },
    "lodgement_date": {
      "description": "Date the certificate was lodged on the register.",
      "$ref": "#/$defs/date"
    },
    "lodged_at": {
      "description": "Date and time the certificate was lodged (ISO 8601, no time zone).",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$",
      "format": "date-time"
    },
    "superseded": {
      "description": "True if a newer certificate exists for the property. Known for Scotland; null for England and Wales, which publishes superseded certificates without a flag.",
      "type": ["boolean", "null"]
    },
    "address_line_1": {
      "description": "First address line (Royal Mail / OS licence terms apply).",
      "type": ["string", "null"],
      "minLength": 1
    },
    "address_line_2": {
      "description": "Second address line (Royal Mail / OS licence terms apply).",
      "type": ["string", "null"],
      "minLength": 1
    },
    "post_town": {
      "description": "Post town (Royal Mail / OS licence terms apply).",
      "type": ["string", "null"],
      "minLength": 1
    },
    "postcode": {
      "description": "Postcode (Royal Mail / OS licence terms apply).",
      "type": ["string", "null"],
      "minLength": 1
    },
    "local_authority_name": {
      "description": "Local authority name as published by the source.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "current_energy_rating": {
      "description": "Current energy efficiency rating band.",
      "$ref": "#/$defs/rating_band"
    },
    "current_energy_efficiency": {
      "description": "Current energy efficiency (SAP) score.",
      "$ref": "#/$defs/sap_score"
    },
    "potential_energy_rating": {
      "description": "Potential energy efficiency rating band.",
      "$ref": "#/$defs/rating_band"
    },
    "potential_energy_efficiency": {
      "description": "Potential energy efficiency (SAP) score.",
      "$ref": "#/$defs/sap_score"
    },
    "property_type": {
      "description": "Property type, lower case.",
      "type": ["string", "null"],
      "enum": ["house", "flat", "maisonette", "bungalow", "park home", null]
    },
    "built_form": {
      "description": "Built form, lower case.",
      "type": ["string", "null"],
      "enum": [
        "detached",
        "semi-detached",
        "mid-terrace",
        "end-terrace",
        "enclosed mid-terrace",
        "enclosed end-terrace",
        null
      ]
    },
    "tenure": {
      "description": "Tenure, lower case; 'rental' spellings normalised to 'rented'.",
      "type": ["string", "null"],
      "enum": ["owner-occupied", "rented (social)", "rented (private)", "unknown", null]
    },
    "construction_age_band": {
      "description": "Construction age band exactly as the source labels it (England and Wales prefix removed). Bands differ between nations; use construction_year_min/max to compare.",
      "type": ["string", "null"],
      "minLength": 1
    },
    "construction_year_min": {
      "description": "First year of the construction age band; null if open-ended or unknown.",
      "$ref": "#/$defs/year"
    },
    "construction_year_max": {
      "description": "Last year of the construction age band; null if open-ended or unknown.",
      "$ref": "#/$defs/year"
    },
    "total_floor_area": {
      "description": "Total floor area in square metres.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "main_fuel_type": {
      "description": "Main fuel: type.",
      "type": ["string", "null"],
      "enum": [
        "anthracite",
        "b30d",
        "b30k",
        "biodiesel (any biomass)",
        "biodiesel (used cooking oil)",
        "biodiesel (vegetable oil)",
        "bioethanol",
        "biogas",
        "biomass",
        "bottled lpg",
        "bulk lpg",
        "coal",
        "dual fuel (mineral and wood)",
        "electricity",
        "heat network",
        "heat pump",
        "house coal",
        "landfill biogas",
        "lng",
        "lpg",
        "lpg special condition",
        "mains gas",
        "mineral oil or liquid biofuel",
        "no heating or hot water system",
        "no system or community network",
        "oil",
        "rapeseed oil",
        "smokeless fuel",
        "waste combustion",
        "waste heat from power stations",
        "wood chips",
        "wood logs",
        "wood pellets (bags)",
        "wood pellets (bulk)",
        null
      ]
    },
    "main_fuel_community": {
      "description": "True for a community (heat network) supply, false if stated as not community.",
      "type": ["boolean", "null"]
    },
    "main_fuel_parts": {
      "description": "Main fuel: number of building parts described.",
      "type": "integer",
      "minimum": 0
    },
    "main_fuel_discarded": {
      "description": "Main fuel: why the description was unusable, if it was.",
      "type": ["string", "null"],
      "enum": ["not in vocabulary", null]
    },
    "glazing_type": {
      "description": "Glazing type: type.",
      "type": ["string", "null"],
      "enum": ["single", "double", "triple", "secondary", null]
    },
    "glazing_installed": {
      "description": "Glazing type: installed.",
      "type": ["string", "null"],
      "enum": ["before 2002", "2002 or later", null]
    },
    "glazing_performance_known": {
